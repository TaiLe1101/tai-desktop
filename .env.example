# URL Backend lưu trữ bản cập nhật (chứa latest.yml và file setup .exe)
UPDATE_URL=https://your-backend.com/updates/

# URL Backend Gateway cho Dubbing v2 (/api/v1/dubbing/*)
# Nếu để trống, app sẽ tự suy ra origin từ UPDATE_URL hoặc fallback trực tiếp tới WORKER_URL
SERVER_URL=https://your-backend.com
SERVER_API_KEY=

# Cấu hình AI Worker (fallback trực tiếp khi không kết nối được SERVER_URL)
WORKER_URL=https://your-worker.trycloudflare.com
WORKER_API_KEY=your_worker_access_key_here
